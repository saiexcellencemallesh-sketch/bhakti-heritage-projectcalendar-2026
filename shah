    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <style>
        /* --- 1. CORE AESTHETICS --- */
        :root {
            --maroon: #800000; /* Deep Royal Maroon */
            --gold: #D4AF37;   /* Metallic Gold */
            --black: #121212;
            --cream: #FAF9F6;  /* Off-white */
            --white: #ffffff;
            --grey: #f4f4f4;
            --overlay: rgba(0,0,0,0.65);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: var(--cream);
            color: var(--black);
            line-height: 1.8;
            overflow-x: hidden;
        }

        h1, h2, h3, h4 {
            font-family: 'Playfair Display', serif;
            font-weight: 700;
        }

        /* --- 2. NAVIGATION & ANIMATIONS --- */
        .page-section {
            display: none;
            opacity: 0;
            transition: opacity 0.6s ease-in-out;
            width: 100%;
            min-height: 100vh;
        }

        .page-section.active {
            display: block;
            opacity: 1;
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 25px;
        }

        .btn-back {
            position: fixed;
            top: 25px;
            left: 25px;
            z-index: 1000;
            background: rgba(255, 255, 255, 0.95);
            color: var(--maroon);
            padding: 12px 25px;
            border-radius: 50px;
            text-decoration: none;
            box-shadow: 0 4px 20px rgba(0,0,0,0.15);
            font-weight: 600;
            font-size: 0.9rem;
            display: none;
            cursor: pointer;
            transition: all 0.3s ease;
            backdrop-filter: blur(5px);
            border: 1px solid rgba(128, 0, 0, 0.1);
        }
        .btn-back:hover { background: var(--maroon); color: var(--white); transform: translateY(-2px); }

        /* --- 3. HERO SECTION --- */
        .hero {
            height: 100vh;
            background: linear-gradient(to bottom, rgba(0,0,0,0.3), rgba(0,0,0,0.8)), url('https://github.com/saiexcellencemallesh-sketch/bhakti-heritage-projectcalendar-2026/blob/main/Manu%20Shah%201.jpeg?raw=true');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: var(--white);
            position: relative;
        }

        .hero-content {
            max-width: 1000px;
            padding: 2rem;
            animation: fadeInUp 1.2s ease-out;
        }

        .hero-content h1 {
            font-size: clamp(3rem, 6vw, 5.5rem);
            margin-bottom: 1.5rem;
            text-shadow: 0 4px 15px rgba(0,0,0,0.6);
            line-height: 1.1;
            color: var(--white);
        }

        .hero-content h2 {
            font-family: 'Montserrat', sans-serif;
            font-size: clamp(0.9rem, 1.5vw, 1.2rem);
            letter-spacing: 4px;
            text-transform: uppercase;
            color: var(--gold);
            margin-bottom: 2.5rem;
            font-weight: 600;
            text-shadow: 0 2px 10px rgba(0,0,0,0.8);
        }
        
        .hero-quote {
            font-size: 1.3rem;
            font-style: italic;
            font-family: 'Playfair Display', serif;
            opacity: 0.95;
            border-top: 1px solid var(--gold);
            border-bottom: 1px solid var(--gold);
            display: inline-block;
            padding: 1.5rem 0;
            max-width: 700px;
            background: rgba(0,0,0,0.2); 
            backdrop-filter: blur(2px);
        }

        /* --- 4. NARRATIVE SECTION --- */
        .narrative { padding: 6rem 0; text-align: center; background: var(--white); }
        .narrative p { max-width: 800px; margin: 0 auto 2rem; font-size: 1.25rem; color: #444; font-weight: 300; }
        .narrative blockquote {
            font-size: 1.8rem; color: var(--maroon); font-family: 'Playfair Display', serif;
            margin: 4rem auto; max-width: 900px; line-height: 1.5;
        }

        /* --- 5. METRICS BAR --- */
        .impact-bar {
            background: url('https://github.com/saiexcellencemallesh-sketch/bhakti-heritage-projectcalendar-2026/blob/main/Sarla%20Hospital.png?raw=true') fixed center/cover;
            position: relative;
            padding: 5rem 0;
            color: var(--white);
        }
        .impact-overlay { position: absolute; top:0; left:0; width:100%; height:100%; background: rgba(0,0,0,0.85); }
        .stats-grid { position: relative; z-index: 2; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 3rem; text-align: center; }
        .stat-item h3 { font-size: 3.5rem; color: var(--gold); margin-bottom: 0.5rem; }
        .stat-item p { text-transform: uppercase; letter-spacing: 2px; font-size: 0.85rem; font-weight: 500; opacity: 0.8; }

        /* --- 6. MENU CARDS --- */
        .menu-section { padding: 6rem 20px; background: var(--cream); }
        .section-header { text-align: center; margin-bottom: 4rem; }
        .section-header h2 { font-size: 3rem; color: var(--maroon); margin-bottom: 1rem; }
        .section-header p { font-size: 1.2rem; color: #666; }

        .menu-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2.5rem;
            max-width: 1300px;
            margin: 0 auto;
        }

        .menu-card {
            background: var(--white);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 15px 35px rgba(0,0,0,0.08);
            transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
            cursor: pointer;
            position: relative;
        }

        .menu-card:hover { transform: translateY(-12px); box-shadow: 0 25px 50px rgba(128, 0, 0, 0.15); }
        
        .menu-img { height: 240px; width: 100%; object-fit: cover; transition: transform 0.5s; }
        .menu-card:hover .menu-img { transform: scale(1.05); }
        
        .menu-placeholder { height: 240px; width: 100%; background: linear-gradient(135deg, #2c3e50, #000000); display: flex; align-items: center; justify-content: center; color: var(--white); }
        .menu-placeholder.red { background: linear-gradient(135deg, var(--maroon), #400000); }
        .menu-placeholder.teal { background: linear-gradient(135deg, #16a085, #2c3e50); }
        
        .menu-text { padding: 2.5rem; text-align: center; position: relative; z-index: 2; background: var(--white); }
        .menu-text h3 { margin-bottom: 0.8rem; color: var(--black); font-size: 1.5rem; }
        .menu-text p { font-size: 0.95rem; color: #666; margin-bottom: 1.5rem; line-height: 1.6; }
        
        .btn-link { 
            display: inline-block; padding: 10px 0;
            color: var(--maroon); text-transform: uppercase; font-size: 0.8rem; letter-spacing: 1.5px; font-weight: 700;
            border-bottom: 2px solid transparent; transition: border 0.3s;
        }
        .menu-card:hover .btn-link { border-bottom: 2px solid var(--gold); }

        /* --- 7. SUB-PAGE STYLES --- */
        .sub-hero {
            height: 60vh;
            background-size: cover;
            background-position: center;
            display: flex;
            align-items: flex-end;
            padding-bottom: 5rem;
            position: relative;
        }
        .sub-hero::before { content:''; position: absolute; top:0; left:0; width:100%; height:100%; background: linear-gradient(to top, rgba(0,0,0,0.9), rgba(0,0,0,0.2)); }
        
        .sub-hero-content { position: relative; z-index: 2; color: var(--white); width: 100%; text-align: center; }
        .sub-hero h1 { font-size: 4rem; margin-bottom: 1rem; text-shadow: 0 2px 10px rgba(0,0,0,0.5); }
        .sub-hero p { font-size: 1.4rem; font-family: 'Montserrat', sans-serif; letter-spacing: 2px; text-transform: uppercase; color: var(--gold); }

        .content-block { padding: 5rem 0; background: var(--white); }
        .content-block.grey { background: #f9f9f9; border-top: 1px solid #eee; border-bottom: 1px solid #eee; }
        
        .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: start; }
        
        /* Tables */
        table { width: 100%; border-collapse: separate; border-spacing: 0; margin-top: 2rem; background: var(--white); border-radius: 8px; overflow: hidden; box-shadow: 0 5px 20px rgba(0,0,0,0.05); }
        th { background: var(--black); color: var(--gold); padding: 18px 25px; text-align: left; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px; }
        td { padding: 20px 25px; border-bottom: 1px solid #eee; color: #444; font-size: 0.95rem; }
        tr:last-child td { border-bottom: none; }
        tr:hover td { background-color: #fafafa; }
        
        .status-urgent { color: #c0392b; font-weight: 700; background: #fdedec; padding: 5px 10px; border-radius: 4px; display: inline-block; font-size: 0.8rem; }
        .status-ok { color: #27ae60; font-weight: 700; background: #eafaf1; padding: 5px 10px; border-radius: 4px; display: inline-block; font-size: 0.8rem; }

        /* Footer */
        footer { background: var(--black); color: var(--white); text-align: center; padding: 5rem 2rem; }
        .footer-logo { font-size: 2rem; font-family: 'Playfair Display', serif; margin-bottom: 0.5rem; }

        @media (max-width: 768px) {
            .two-col { grid-template-columns: 1fr; gap: 3rem; }
            .hero-content h1 { font-size: 3rem; }
            .menu-card { margin-bottom: 2rem; }
        }
    </style>
</head>
